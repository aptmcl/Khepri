      <Project>{63155619-47cc-464b-beab-78097e19f6b7}</Project>
      <Name>KhepriBase</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="EnsureX64Platform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="KhepriAutoCAD only supports the x64 platform. Select Debug|x64 or Release|x64." />
  </Target>
  <Target Name="AfterBuild">
    <MakeDir Directories="$(ProjectDir)KhepriAutoCAD.bundle\Contents" />
    <Error Condition="!Exists('$(TargetDir)KhepriBase.dll')" Text="KhepriBase.dll was not found in $(TargetDir). Build the KhepriBase project reference before deploying." />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)KhepriAutoCAD.bundle\Contents" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)KhepriBase.dll" DestinationFolder="$(ProjectDir)KhepriAutoCAD.bundle\Contents" SkipUnchangedFiles="true" />
    <!-- Sign the deployed add-in DLL with the local self-signed dev cert (CN=KhepriSelfSign). Sign
         ONLY KhepriAutoCAD.dll — the bundle's KhepriBase.dll is already signed, inherited from
         KhepriBase's own build through the bin -> bundle copies, so it is never re-signed here.
         ../sign.ps1 no-ops when the cert is absent, so it never breaks the build. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\sign.ps1&quot; &quot;$(ProjectDir)KhepriAutoCAD.bundle\Contents&quot; KhepriAutoCAD.dll" ContinueOnError="true" />
    <!-- Refresh the DEPLOYED bundle too: Julia/KhepriAutoCAD/Plugin is what
         update_plugin() actually installs for users. The 2026-07-30 incident
         was a rebuild that refreshed only THIS project-side bundle (above)
         while the deployed one stayed stale; copying both from the same build
         makes that class of divergence impossible. The Condition (rather than
         ContinueOnError, which silently downgrades a locked/read-only copy
         failure to a warning) makes a failed copy FAIL the build when the
         monorepo layout is present, while out-of-tree builds skip it. CI's
         staleness check verifies the committed copies match the sources. -->
    <Copy SourceFiles="$(ProjectDir)KhepriAutoCAD.bundle\Contents\KhepriAutoCAD.dll;$(ProjectDir)KhepriAutoCAD.bundle\Contents\KhepriBase.dll" DestinationFolder="$(ProjectDir)..\..\..\Julia\KhepriAutoCAD\Plugin\KhepriAutoCAD.bundle\Contents" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\..\..\Julia\KhepriAutoCAD\Plugin\KhepriAutoCAD.bundle\Contents')" />
    <Copy SourceFiles="$(ProjectDir)KhepriAutoCAD.bundle\PackageContents.xml" DestinationFolder="$(ProjectDir)..\..\..\Julia\KhepriAutoCAD\Plugin\KhepriAutoCAD.bundle" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)..\..\..\Julia\KhepriAutoCAD\Plugin\KhepriAutoCAD.bundle')" />
  </Target>
</Project>
