        public byte ShapeCode(RhinoObject obj) {
            GeometryBase geo = obj.Geometry;
            if (geo is Point) {
                return 1;
            }
            if (geo is Curve) {
                Curve c = geo as Curve;
                if (c.IsCircle()) {
                    return 2;
                } else if (c.IsPolyline()) {
                    if (c is LineCurve) {
                        return 3;
                    } else if (c is NurbsCurve) {
                        return (byte)(7 + (c.IsClosed ? 100 : 0));
                    } else {
                        return (byte)(4 + (c.IsClosed ? 100 : 0));
                    }
                } else if (c.IsEllipse()) {
                    return 8;
                } else if (c.IsArc()) {
                    return 9;
                } else { // Assume is a spline
                    return (byte)(7 + (c.IsClosed ? 100 : 0));
                }
            }
            if (geo is Brep) {
                Brep s = geo as Brep;
                if (s.IsSolid) {
                    Surface f = s.Faces[0];
                    if (s.Faces.Count == 1) {
                        return (byte)(
                            f.IsSphere() ? 81 :
                            f.IsTorus() ? 84 :
                            80);
                    } else if (s.Faces.Count == 2) {
                        return (byte)(
                            f.IsCone() ? 83 :
                            80);
                    } else if (s.Faces.Count == 3) {
                        return (byte)(
                            f.IsCylinder() ? 82 :
                            80);
                    } else {
                        return 0;
                    }
                } else {
                    return 0;
                }
            }
            if (geo is Surface) {
                Surface s = geo as Surface;
                if (s.IsSolid) {
                    return (byte)(80);
                } else {
                    return (byte)(s.IsPlanar() ? 41 : 40);
                }
            } else {
                return 0;
            }
        }

