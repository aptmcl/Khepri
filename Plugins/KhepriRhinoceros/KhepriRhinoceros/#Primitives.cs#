            Curve arc = new Arc(new Circle(new Plane(c, n), radius), new Interval(startAngle, endAngle)).ToNurbsCurve();
            return SurfaceFromCurves(new Curve[] {
                arc,
                new PolylineCurve(new Point3d[] { c, arc.PointAtStart }).ToNurbsCurve(),
                new PolylineCurve(new Point3d[] { c, arc.PointAtEnd }).ToNurbsCurve() });
        }
