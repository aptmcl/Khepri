        public Point3d[] LineVertices(RhinoObject obj) {
            GeometryBase geo = obj.Geometry;
            if (geo is LineCurve) {
                LineCurve c = (LineCurve)geo;
                return new Point3d[] { c.PointAtStart, c.PointAtEnd };
            } else if (geo is PolylineCurve) {
                PolylineCurve c = (PolylineCurve)geo;
                Polyline polyline = new Polyline();
                Debug.Assert(c.TryGetPolyline(out polyline));
                return polyline.ToArray();
            } else {
                throw new Exception("Unknown object");
            }
        }
